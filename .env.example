# Chave da API da Anthropic (https://console.anthropic.com/settings/keys)
# Na Vercel: Project Settings > Environment Variables > adicione ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: sobrescrever o modelo usado (padrão: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# String de conexão do Postgres (a Vercel injeta automaticamente se você
# conectar um banco "Vercel Postgres" ao projeto — veja o README)
POSTGRES_URL=postgres://usuario:senha@host:5432/banco

# Qualquer string longa e aleatória, usada para assinar o cookie de sessão.
# Gere uma com: openssl rand -base64 32
JWT_SECRET=troque-por-uma-string-aleatoria-longa
